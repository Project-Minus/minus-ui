{
  "name": "minus-ui",
  "version": "0.1.1",
  "description": "awesome minus-ui toolkit!",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Project-Minus/minus-ui"
  },
  "keywords": ["ui", "component-library", "react", "typescript"],
  "author": "park minkyu",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:dist": "pnpm -r exec rm -rf dist",
    "clean:modules": "pnpm -r exec rm -rf node_modules",
    "clean:all": "pnpm -r exec rm -rf node_modules && pnpm -r exec rm -rf dist",
    "clean": "rm -rf node_modules pnpm-lock.yaml && pnpm store prune",
    "build": "pnpm -r run build",
    "build:type": "pnpm --filter @minus-ui/types run build",
    "build:component": "pnpm --filter @minus-ui/components run build",
    "build:styles": "pnpm --filter @minus-ui/styles run build",
    "build:core": "pnpm --filter @minus-ui/core run build",
    "dev:component": "pnpm --filter @minus-ui/components run dev",
    "dev:styles": "pnpm --filter @minus-ui/styles run dev",
    "dev:type": "pnpm --filter @minus-ui/types run dev",
    "dev:core": "pnpm --filter @minus-ui/core run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "publish:component": "pnpm --filter @minus-ui/components publish --access public",
    "publish:styles": "pnpm --filter @minus-ui/styles publish --access public",
    "publish:type": "pnpm --filter @minus-ui/type publish --access public",
    "publish:core": "pnpm --filter @minus-ui/core publish --access public",
    "publish:all": "pnpm run build && pnpm -r publish --access public --no-git-checks"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.15.0",
    "husky": "9.1.6",
    "lint-staged": "^15.4.3",
    "path": "^0.12.7",
    "prettier": "^3.5.2",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
