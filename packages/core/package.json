{
  "name": "@minus-ui/core",
  "version": "0.9.9",
  "type": "module",
  "description": "awesome minus-ui toolkit with tailwind plugin",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Project-Minus/minus-ui/tree/develop/packages/core"
  },
  "keywords": [
    "ui",
    "component-library",
    "react",
    "typescript"
  ],
  "author": "park minkyu",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./plugin":{
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./plugin.css":{
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist","*.css"
  ],
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "tailwind-merge": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
